APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Masa berlaku token login (menit); diperpanjang selama ada aktivitas
TOKEN_ADMIN_MENIT=30
TOKEN_USER_MENIT=60

# Tempat sampah: tipe dan unit yang dihapus dibuang permanen setelah sekian hari
HARI_SAMPAH=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rental_mobil
DB_USERNAME=root
DB_PASSWORD=
# Database khusus test (rental_mobil_test) diatur di phpunit.xml; host, port, user, dan sandi memakai nilai di atas.

# Satu-satunya database yang boleh direset oleh php artisan demo:reset (rentalmobil dan rentalmobil_test selalu ditolak)
DEMO_RESET_DATABASE=rental_mobil

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway pembayaran: palsu (bawaan, tanpa jaringan dan tanpa kunci, cocok untuk lokal dan Swagger) atau midtrans.
# APP_ENV=testing selalu memakai gateway palsu.
PEMBAYARAN_GATEWAY=palsu
# Kunci server dipakai untuk tanda tangan webhook (/webhook/midtrans) dan, bila PEMBAYARAN_GATEWAY=midtrans, ke Snap sandbox.
# Webhook ditolak (403) bila kosong. Untuk mencoba webhook secara lokal, isi nilai apa saja lalu hitung sha512 dengan nilai itu.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Akun admin awal (php artisan migrate --seed). Di production ADMIN_PASSWORD WAJIB diisi dengan kata sandi sendiri:
# seeder menolak kata sandi bawaan. Admin tetap diminta mengganti kata sandi ini saat login pertama.
ADMIN_EMAIL=admin@rental.test
ADMIN_PASSWORD=
ADMIN_NAMA="Admin Utama"

# Menit sejak akun belum terverifikasi dibuat sampai boleh ditimpa pendaftaran ulang (email sama). Sebelum itu ditolak.
DAFTAR_ULANG_TUNGGU_MENIT=60

# --- Pengaman dan jaringan production ---
# Di APP_ENV=production aplikasi menolak berjalan bila APP_DEBUG=true, MAIL_MAILER=log, atau PEMBAYARAN_GATEWAY bukan midtrans.

# Proxy tepercaya (nginx, Cloudflare, ngrok), dipisah koma, mis. 10.0.0.5,10.0.0.6. Kosong = tidak percaya proxy mana pun
# (perilaku lokal). Di belakang proxy WAJIB diisi: bila tidak, semua pengguna terbaca berasal dari IP proxy dan berbagi satu
# jatah batas login dan daftar. "*" hanya bila server hanya bisa dijangkau lewat proxy.
TRUSTED_PROXIES=

# CORS: alamat frontend yang boleh memanggil API dari browser, dipisah koma, tanpa garis miring di akhir
# (mis. https://rental.example.com,https://admin.example.com). Kosong = FRONTEND_URL (bawaan http://localhost:5173).
# Swagger di /docs satu origin dengan API sehingga tidak perlu didaftarkan.
CORS_ALLOWED_ORIGINS=
